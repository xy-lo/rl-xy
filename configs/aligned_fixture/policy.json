{
  "schema_version": "rlxy.aligned_policy/1",
  "policy": {
    "prompt_batch_size": 2,
    "responses_per_prompt": 2,
    "ppo_mini_batch_prompts": 2,
    "train_tp": 2,
    "rollout_tp": 1,
    "pipeline_parallel": 1,
    "train_micro_batch_trajectories": 2,
    "logprob_micro_batch_trajectories": 2,
    "ppo_epochs": 1,
    "balance_batch": false,
    "shuffle": false,
    "dynamic_batching": false,
    "norm_adv_by_std": true,
    "loss_aggregation": "token-mean",
    "policy_loss": "vanilla",
    "clip_ratio": 0.2,
    "max_grad_norm": 1.0,
    "use_kl_loss": true,
    "use_kl_in_reward": false,
    "kl_coefficient": 0.001,
    "entropy_coefficient": 0.0,
    "distributed_optimizer": true,
    "offload": false,
    "weight_sync": "naive_per_tensor_export_distinct_rollout",
    "kv_sharding": "partition_no_replication"
  }
}
